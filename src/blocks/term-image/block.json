{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-term-images/term-image",
  "title": "Term Image",
  "description": "Displays the featured image assigned to a taxonomy term.",
  "category": "media",
  "icon": "format-image",
  "keywords": [ "term", "taxonomy", "image", "category", "tag" ],
  "attributes": {
    "termId": {
      "type": "integer",
      "default": 0
    },
    "imageSize": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "html": false,
    "color": {
      "background": false,
      "text": false
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "textdomain": "wp-term-images"
}
